# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
# Postgres with PostGIS (docker-compose provides this)
DATABASE_URL=postgresql://droba:droba@localhost:5432/droba?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379
# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in verification emails)
WEB_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Email: console (prints links to the terminal) | resend | ses
EMAIL_PROVIDER=console
EMAIL_FROM="Droba <no-reply@droba.ng>"
RESEND_API_KEY=
AWS_REGION=eu-west-2
# Photo uploads (S3 or Cloudflare R2). Leave blank to accept photo URLs directly in development.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------- Web (apps/web) ----------
# Where the browser reaches the API (and Socket.io)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the Next.js server reaches the API (same as above locally; internal URL in production)
API_INTERNAL_URL=http://localhost:4000
