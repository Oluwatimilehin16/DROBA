# Copy to .env (repo root). Both apps read it in development.

# --- API ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://droba:droba@localhost:5432/droba?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
# Shared secret between the web server and the API (server-side page renders skip per-IP rate limits)
INTERNAL_API_KEY=change-me-to-a-random-string
# console prints emails to the API log; use resend or ses in production
EMAIL_PROVIDER=console
EMAIL_FROM=Droba <hello@droba.ng>
RESEND_API_KEY=
AWS_REGION=eu-west-2
# Photo storage (S3 or Cloudflare R2). Leave S3_BUCKET empty to store uploads locally in apps/api/.uploads
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Web ---
# Where the browser opens the WebSocket (the API)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the Next.js server reaches the API
API_INTERNAL_URL=http://localhost:4000
# Public site address, used in share links (droba.ng/<store>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
